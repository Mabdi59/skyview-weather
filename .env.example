# OpenWeatherMap API Key
# Get your free API key at: https://openweathermap.org/api
VITE_OPENWEATHER_API_KEY=your_api_key_here

# Demo Mode (set to 'true' to use demo data without API key)
# VITE_DEMO_MODE=true

# Enable auto geo-prompt on load (optional)
# When set to 'true', the app will ask for geolocation on page load and fetch by coordinates.
# VITE_ENABLE_GEO=true
